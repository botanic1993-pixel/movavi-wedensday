@bot.message_handler(commands=['start'])
def start_message(message):
    keyboard = telebot.types.InlineKeyboardMarkup()
    evaluate = telebot.types.InlineKeyboardButton('Оценить преподавателя', callback_data='evaluate')
    rating = telebot.types.InlineKeyboardButton('Рейтинг преподавателей', callback_data='rating')
    keyboard.add(evaluate)
    keyboard.add(rating)
    bot.send_message(message.chat.id, 'Выберите одно из действий:', reply_markup=keyboard)

@bot.callback_query_handler(lambda callback: True)
def func(callback):
    user_id = callback.message.chat.id
    data = callback.data
    if data == 'evaluate':
        keyboard  = telebot.types.InlineKeyboardMarkup()
        for course in courses.keys():
            keyboard.add(telebot.types.InlineKeyboardButton(course, callback_data = course))
        bot.send_message(user_id, 'Выберите курс: ', reply_markup = keyboard)
    elif data in courses:
        keyboard  = telebot.types.InlineKeyboardMarkup()
        for teacher in courses[data]:
            keyboard.add(telebot.types.InlineKeyboardButton(teacher, callback_data = teacher))
        bot.send_message(user_id, 'Выберите предподавателя: ', reply_markup = keyboard)
    elif data in teachers:
        info = (
            f'Имя предподавателя: {data}\n'
            f'Какие курсы предподает: {teachers[data]["courses"]}\n'
            f'Лайков: {teachers[data]["likes"]}, Дизлайков: {teachers[data]["dislikes"]}'
        )
        keyboard  = telebot.types.InlineKeyboardMarkup()
        like = telebot.types.InlineKeyboardButton('👍', callback_data = f'like_{data}')
        dislike = telebot.types.InlineKeyboardButton('👎', callback_data = f'dislike_{data}')
        keyboard.add(like, dislike)
        bot.send_photo(user_id, teachers[data]['photo'])
        bot.send_message(user_id, info, reply_markup=keyboard)
    elif data.startswith('like'):
        name = data.split('_')[1]
        if user_id in teachers[name]['voted']:
            bot.send_message(user_id, 'Вы уже голосовали за этого предподавателя')
        else:
            teachers[name]['likes']+=1
            teachers[name]['voted'].append(user_id)
            bot.send_message(user_id, 'Ваш голос записан')
    elif data.startswith('dislike'):
        name = data.split('_')[1]
        if user_id in teachers[name]['voted']:
            bot.send_message(user_id, 'Вы уже голосовали за этого предподавателя')
        else:
            teachers[name]['dislikes']+=1
            teachers[name]['voted'].append(user_id)
            bot.send_message(user_id, 'Ваш голос записан')
    elif data == 'rating':
        rating = []
        for name, info in teachers.items():
            votes = info['likes'] + info['dislikes']
            rating.append((name, (info['likes'] - info['dislikes']) / votes))
        rating.sort(key=lambda x: -x[1])
        result = 'ТОП-3 преподавателя АКЛ:\n\n'
        for i, teacher in enumerate(rating[:3]):
            result += f'№{i + 1}: {teacher[0]} ({teacher[1]:.2f})\n'
        bot.send_message(user_id, result)

